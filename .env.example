# OPTIONAL — Greg does not need this.
#
# By default he runs a local model through Ollama: no key, no account, offline.
# This file only matters if you'd rather he used Anthropic's Claude instead.
#
# If you ever want that: copy this file to ".env" (drop the .example), paste a
# key from https://console.anthropic.com after the = sign, and restart Greg.
# He'll prefer Claude automatically. To keep using the local model even with a
# key present, set "provider": "ollama" in config.json.

ANTHROPIC_API_KEY=


# OPTIONAL — only needed to play a *named* song on Spotify.
#
# Pause, skip and volume work without any of this, through the media keys.
#
# To set it up:
#   1. Go to https://developer.spotify.com/dashboard and create an app
#      (free, instant, no review).
#   2. Add this exact Redirect URI to it:
#        http://127.0.0.1:4747/api/spotify/callback
#      Spotify requires the literal 127.0.0.1 here — "localhost" is rejected.
#   3. Copy the Client ID below. There's no secret to copy: Greg uses PKCE,
#      so it never stores one.
#   4. Restart Greg, then visit http://127.0.0.1:4747/api/spotify/login once
#      and approve. The refresh token is saved to spotify-tokens.json.
#
# Playing music through the API needs Spotify Premium — free accounts get a
# 403 from Spotify no matter what.

SPOTIFY_CLIENT_ID=
